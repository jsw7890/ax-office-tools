# 값을 채우지 않으면 이 PC의 로컬 샘플 모드로 동작합니다.
# Supabase 키와 AI 키는 사람 승인 없이 만들지 않습니다.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 비우면 실행할 때 .data/ 안에 서명 키를 만듭니다. 저장소에 넣지 마세요.
SESSION_SECRET=

# 기본(ollama): 이 PC의 Ollama가 켜져 있으면 조문을 근거로 답을 다듬습니다. 꺼져 있으면 조문 검색입니다.
# mock 이면 조문 검색만 씁니다. claude 는 승인 전 호출을 거절합니다. 유료 키는 쓰지 않습니다.
LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b
LLM_CALLS_APPROVED=false
ANTHROPIC_API_KEY=
