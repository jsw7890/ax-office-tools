# 값을 채우지 않으면 이 PC의 로컬 샘플 모드로 동작합니다.
# Supabase 키와 AI 키는 사람 승인 없이 만들지 않습니다.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 비우면 실행할 때 .data/ 안에 서명 키를 만듭니다. 저장소에 넣지 마세요.
SESSION_SECRET=

# mock 이면 규정 원문만 보고 답합니다. claude 로 바꿔도 승인 전에는 호출하지 않습니다.
LLM_PROVIDER=mock
LLM_CALLS_APPROVED=false
ANTHROPIC_API_KEY=
